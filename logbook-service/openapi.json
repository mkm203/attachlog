  "components": {
    "schemas": {
      "EntryCreate": {
        "properties": {
          "week": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Week"
          },
          "tasks": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Tasks"
          },
          "hours": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Hours"
          }
        },
        "type": "object",
        "required": [
          "week",
          "tasks",
          "hours"
        ],
        "title": "EntryCreate",
        "examples": [
          {
            "hours": 38,
            "tasks": "Installed the dev environment and fixed two bugs.",
            "week": 1
          }
        ]
      },
      "EntryOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "placement_id": {
            "type": "string",
            "title": "Placement Id"
          },
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "week": {
            "type": "integer",
            "title": "Week"
          },
          "tasks": {
            "type": "string",
            "title": "Tasks"
          },
          "hours": {
            "type": "integer",
            "title": "Hours"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "placement_id",
          "student_id",
          "week",
          "tasks",
          "hours",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "EntryOut",
        "examples": [
          {
            "created_at": "2026-09-14T10:00:00Z",
            "hours": 38,
            "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
            "placement_id": "5c1e6f2a-9b7d-4c3e-8a1f-2d6b9e4c7a10",
            "status": "pending",
            "student_id": "stu-1",
            "tasks": "Installed the dev environment and fixed two bugs.",
            "updated_at": "2026-09-14T10:00:00Z",
            "week": 1
          }
        ]
      },
      "EntryPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EntryOut"
            },
            "type": "array",
            "title": "Items"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "title": "EntryPage",
        "examples": [
          {
            "items": [
              {
                "created_at": "2026-09-14T10:00:00Z",
                "hours": 38,
                "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
                "placement_id": "5c1e6f2a-9b7d-4c3e-8a1f-2d6b9e4c7a10",
                "status": "pending",
                "student_id": "stu-1",
                "tasks": "Fixed two bugs.",
                "updated_at": "2026-09-14T10:00:00Z",
                "week": 1
              }
            ],
            "page": 1,
            "page_size": 10,
            "total": 1
          }
        ]
      },
      "EntryUpdate": {
        "properties": {
          "tasks": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Tasks"
          },
          "hours": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Hours"
          }
        },
        "type": "object",
        "required": [
          "tasks",
          "hours"
        ],
        "title": "EntryUpdate",
        "examples": [
          {
            "hours": 40,
            "tasks": "Added tests and reviewed the deployment notes."
          }
        ]
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "The one error format of every service: {\"error\": {\"code\", \"message\", \"details\"}}.",
        "examples": [
          {
            "error": {
              "code": "entry_exists",
              "message": "An entry already exists for week 2"
            }
          }
        ]
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Progress": {
        "properties": {
          "placement_id": {
            "type": "string",
            "title": "Placement Id"
          },
          "total_weeks": {
            "type": "integer",
            "title": "Total Weeks"
          },
          "submitted": {
            "type": "integer",
            "title": "Submitted"
          },
          "approved": {
            "type": "integer",
            "title": "Approved"
          },
          "pending": {
            "type": "integer",
            "title": "Pending"
          },
          "rejected": {
            "type": "integer",
            "title": "Rejected"
          },
          "completion_percent": {
            "type": "number",
            "title": "Completion Percent"
          },
          "comments": {
            "items": {
              "$ref": "#/components/schemas/ProgressComment"
            },
            "type": "array",
            "title": "Comments"
          }
        },
        "type": "object",
        "required": [
          "placement_id",
          "total_weeks",
          "submitted",
          "approved",
          "pending",
          "rejected",
          "completion_percent",
          "comments"
        ],
        "title": "Progress",
        "examples": [
          {
            "approved": 1,
            "comments": [
              {
                "comment": "Please detail the tasks.",
                "decision": "rejected",
                "reviewer_id": "cs-1",
                "week": 2
              }
            ],
            "completion_percent": 8.3,
            "pending": 1,
            "placement_id": "5c1e6f2a-9b7d-4c3e-8a1f-2d6b9e4c7a10",
            "rejected": 1,
            "submitted": 3,
            "total_weeks": 12
          }
        ]
      },
      "ProgressComment": {
        "properties": {
          "week": {
            "type": "integer",
            "title": "Week"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "comment": {
            "type": "string",
            "title": "Comment"
          },
          "reviewer_id": {
            "type": "string",
            "title": "Reviewer Id"
          }
        },
        "type": "object",
        "required": [
          "week",
          "decision",
          "comment",
          "reviewer_id"
        ],
        "title": "ProgressComment",
        "examples": [
          {
            "comment": "Please detail the tasks.",
            "decision": "rejected",
            "reviewer_id": "cs-1",
            "week": 2
          }
        ]
      },
      "ReviewCreate": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "title": "Decision"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "ReviewCreate",
        "examples": [
          {
            "decision": "approved"
          },
          {
            "comment": "Please detail the tasks.",
            "decision": "rejected"
          }
        ]
      },
      "ReviewOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "entry_id": {
            "type": "string",
            "title": "Entry Id"
          },
          "reviewer_id": {
            "type": "string",
            "title": "Reviewer Id"
